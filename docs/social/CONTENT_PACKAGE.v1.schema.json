{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlacaClara Social Content Package v1 - editorial exchange only; never a publish token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "brand_id",
    "platform",
    "locale",
    "objective",
    "editorial",
    "copy",
    "claims",
    "product_snapshot",
    "novelty",
    "creative",
    "gates",
    "release",
    "measurement"
  ],
  "properties": {
    "schema_version": {
      "const": "placaclara-social-package/v1"
    },
    "content_id": {
      "type": "string",
      "minLength": 8
    },
    "brand_id": {
      "const": "placaclara"
    },
    "platform": {
      "enum": [
        "tiktok",
        "instagram"
      ]
    },
    "locale": {
      "const": "es-PE"
    },
    "objective": {
      "enum": [
        "DISCOVERY",
        "EDUCATION",
        "TRUST",
        "COVERAGE_INTENT",
        "PURCHASE_INTENT"
      ]
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience_problem",
        "topic_id",
        "angle_id",
        "lesson_id",
        "hook_family",
        "primary_action"
      ],
      "properties": {
        "audience_problem": {
          "type": "string",
          "minLength": 2
        },
        "topic_id": {
          "type": "string",
          "minLength": 2
        },
        "angle_id": {
          "type": "string",
          "minLength": 2
        },
        "lesson_id": {
          "type": "string",
          "minLength": 2
        },
        "hook_family": {
          "type": "string",
          "minLength": 2
        },
        "primary_action": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "subhook",
        "caption",
        "cta",
        "alt_text",
        "visual_text"
      ],
      "properties": {
        "hook": {
          "type": "string",
          "minLength": 5
        },
        "subhook": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "minLength": 5
        },
        "cta": {
          "type": "string",
          "minLength": 3
        },
        "alt_text": {
          "type": "string",
          "minLength": 5
        },
        "visual_text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "category",
          "provenance",
          "evidence_refs",
          "verified_at",
          "capability_code",
          "limitation"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 2
          },
          "text": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "enum": [
              "EDUCATION",
              "PRICE",
              "COVERAGE",
              "SOURCE_STATUS",
              "PAYMENT",
              "RESULT",
              "COMPARISON",
              "TESTIMONIAL",
              "AUTHORITY"
            ]
          },
          "provenance": {
            "enum": [
              "OFFICIAL",
              "OBSERVED",
              "INFERRED",
              "INSPIRED",
              "GENERATED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    },
    "product_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "evidence_ref",
        "price_pen",
        "enabled_capabilities",
        "commercial_ready",
        "launch_profile",
        "live_deployment_verified"
      ],
      "properties": {
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_pen": {
          "type": [
            "number",
            "null"
          ]
        },
        "enabled_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "IDENTITY",
              "REGISTRY_CURRENT_OWNER",
              "REGISTRY_HISTORY",
              "RESTRICTIONS",
              "SOAT",
              "CITV",
              "FINES_NATIONAL",
              "FINES_LIMA",
              "FINES_CALLAO",
              "THEFT",
              "CAPTURE_ORDERS",
              "CLAIMS",
              "GNV",
              "VALUATION"
            ]
          },
          "uniqueItems": true
        },
        "commercial_ready": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "launch_profile": {
          "enum": [
            "REGISTRY_LEAN",
            "FULL",
            null
          ]
        },
        "live_deployment_verified": {
          "type": "boolean"
        }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_dimensions",
        "published_ref",
        "scheduled_ref",
        "planned_ref",
        "approved_ref",
        "review_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "REVIEW_REQUIRED",
            "PASS",
            "REJECT"
          ]
        },
        "checked_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "topic",
              "angle",
              "lesson",
              "hook_family",
              "example",
              "visual_pattern",
              "structure",
              "cta"
            ]
          },
          "uniqueItems": true
        },
        "published_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheduled_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "planned_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "asset_ref",
        "sha256",
        "mark_ref",
        "visual_scope",
        "safe_zone_review_ref",
        "phone_review_ref",
        "design_approval_ref",
        "rights_review_ref",
        "illustration_disclosure"
      ],
      "properties": {
        "format": {
          "enum": [
            "vertical_9_16",
            "photo_carousel",
            "square_1_1",
            "portrait_4_5",
            "story_9_16"
          ]
        },
        "asset_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "mark_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "visual_scope": {
          "enum": [
            "DRAFT",
            "RENDERED_UNREVIEWED",
            "REVIEWED"
          ]
        },
        "safe_zone_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "design_approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "illustration_disclosure": {
          "type": "string"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factual",
        "product_claims",
        "price",
        "novelty",
        "design",
        "safe_zone",
        "legal",
        "owner"
      ],
      "properties": {
        "factual": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "product_claims": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "price": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "novelty": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "design": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "safe_zone": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "legal": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "owner": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner_receipt",
        "scheduled_at",
        "provider_receipt",
        "published_url"
      ],
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "READY_FOR_HUMAN_REVIEW",
            "APPROVED_FOR_MANUAL_SCHEDULING",
            "SCHEDULED",
            "PUBLISHED"
          ]
        },
        "owner_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheduled_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "primary_metric",
        "window",
        "traffic_mode",
        "attribution",
        "baseline_ref",
        "external_receipt"
      ],
      "properties": {
        "hypothesis": {
          "type": "string"
        },
        "primary_metric": {
          "type": "string"
        },
        "window": {
          "enum": [
            "T_PLUS_24H",
            "T_PLUS_7D"
          ]
        },
        "traffic_mode": {
          "enum": [
            "ORGANIC",
            "PAID",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "attribution": {
          "enum": [
            "UNKNOWN",
            "UNVERIFIED",
            "VERIFIED_JOIN"
          ]
        },
        "baseline_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
