# Paid-provider kill switch. Keep false unless the environment is intentionally live.
VEHICLE_PROVIDER_EXECUTION_ENABLED="false"

# Anonymous preview must not spend credits by default.
PREVIEW_PROVIDER_MODE="NONE"

# ---------------------------------------------------------------------------
# Mercado Pago
